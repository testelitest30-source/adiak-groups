<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- ADIAK 1.0: FCM defaults (status-bar icon + brand colour) -->
        <meta-data android:name="com.google.firebase.messaging.default_notification_icon" android:resource="@drawable/ic_stat_adiak" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_color" android:resource="@color/adiak_brand" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_channel_id" android:value="adiak_default" />
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+: runtime permission for push notifications (asked once, after login) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Used by the existing web features: voice messages (getUserMedia audio) and the camera capture -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Required for voice messages in the APK: Capacitor's BridgeWebChromeClient grants a WebView AUDIO_CAPTURE request
         only when RECORD_AUDIO *and* MODIFY_AUDIO_SETTINGS are both granted. An undeclared permission is always reported
         as denied, which made getUserMedia fail with NotAllowedError even after the user allowed the microphone.
         MODIFY_AUDIO_SETTINGS is a normal (install-time) permission: no extra prompt. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>
